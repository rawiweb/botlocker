[Unit]
Description=Restore BotLocker IPset and Iptables Rule
After=local-fs.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/botlocker/botlocker.conf
ExecStartPre=/bin/sh -c 'set -a; . /etc/botlocker/botlocker.conf; /sbin/ipset create "$IPSET_NAME" $IPSET_PARAMS'
ExecStart=/bin/sh -c 'set -a; . /etc/botlocker/botlocker.conf; /sbin/ipset restore -! < /etc/botlocker/ipset.${IPSET_NAME}.conf'
ExecStartPost=/bin/sh -c 'set -a; . /etc/botlocker/botlocker.conf; /sbin/iptables -I INPUT 1 -m set --match-set "$IPSET_NAME" src -j DROP 2>/dev/null || true'
ExecStop=/bin/sh -c 'set -a; . /etc/botlocker/botlocker.conf; /sbin/ipset save "$IPSET_NAME" > /etc/botlocker/ipset.${IPSET_NAME}.conf'

[Install]
WantedBy=multi-user.target