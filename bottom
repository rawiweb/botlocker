#!/bin/bash
# --- botlocker Production Logic ---
echo "Source"
source /etc/botlocker/botlocker.conf
echo "Start $DRY_RUN"
DRY_RUN=true
echo "Start $DRY_RUN"
source /var/www/vhosts/rawiweb.de/botlocker/botlocker/common.sh


echo "DR $DRY_RUN"

# --- REPRODUCTION STEPS ---

RAW_RESULT="$(load_section_patterns "admin-access" "MY_IPS")"
HONEY_PATHS=$(load_section_patterns "web-honey" "BLACKLIST")
declare -p RAW_RESULT
MANUAL_IPS=$(load_section_patterns "admin-access" "MY_IPS")
AUTO_IPS=$(load_section_patterns "admin-auto" "WHITELIST" | sed -E 's/\|[0-9]+//g')
# 1. Join them
MY_IPS="${MANUAL_IPS}|${AUTO_IPS}"

# 2. Clean up using PURE BASH (This protects the backslashes!)
printf "DEBUG: MANUAL_IPS is [%s]\n" "$MANUAL_IPS"
printf "DEBUG: AUTO_IPS is [%s]\n" "$AUTO_IPS"

MY_IPS="${MANUAL_IPS}|${AUTO_IPS}"
MY_IPS="${MY_IPS//||/|}"
MY_IPS="${MY_IPS#|}"
MY_IPS="${MY_IPS%|}"

printf "FINAL MY_IPS: %s\n" "$MY_IPS"

MANUAL_IPS=$(load_section_patterns "admin-access" "MY_IPS")
AUTO_IPS=$(load_section_patterns "admin-auto" "WHITELIST" | sed -E 's/\|[0-9]+//g')
MY_IPS="${MANUAL_IPS}|${AUTO_IPS}"
MY_IPS=$(echo "$MY_IPS" | sed 's/|\|*/|/g; s/^|//; s/|$//')
printf "CURRENT MY_IPS: %s\n" "$MY_IPS"