#!/bin/bash
# --- botlocker Production Logic ---
source /etc/botlocker/botlocker.conf
source /etc/botlocker/common.sh

# 1. INITIALIZE
HONEY_PATHS=$(load_section_patterns "web-honey" "BLACKLIST")
BAD_BOTS=$(load_section_patterns "web-bad" "BLACKLIST")
if [ -z "$HONEY_PATHS" ]; then HONEY_PATHS="REALLY_LONG_RANDOM_STRING_TO_SKIP"; fi
IGNORE_STRINGS=$(load_section_patterns "web" "WHITELIST")
if [ -z "$IGNORE_STRINGS" ]; then IGNORE_STRINGS="--NONE-FOUND--"; fi
MY_IPS=$(load_section_patterns "admin" "MY_IPS")
CURRENT_TOTAL=$(ensure_firewall_integrity)
AWKH_PATHS=$(echo "$HONEY_PATHS" | sed 's/\\./\\\\./g')
AWKB_BOTS=$(echo "$BAD_BOTS" | sed 's/\\./\\\\./g')
BANNED_THIS_RUN=0
# 2. THE MINER
# Uses the proven find + grep -EH combination
#echo "$ACCESS_LOG_DIR"
#RESULTS=$(find $ACCESS_LOG_DIR -type f -name "*access*log" -mmin -60 -exec grep -aiEH " 404 | 403 | 400 |($HONEY_PATHS)|($BAD_BOTS)" {} + 2>/dev/null | \
RESULTS=$(find $ACCESS_LOG_DIR -type f -name "*access*log" -exec grep -aiEH " 404 | 403 | 400 |($HONEY_PATHS)|($BAD_BOTS)" {} + 2>/dev/null | \
    grep -vE "$MY_IPS" | \
    grep -vE "$IGNORE_STRINGS" | \
    awk -F':' -v hp="$AWKH_PATHS" -v bb="$AWKB_BOTS" '
    {
        path=$1; 
        line=$0; sub(/^[^:]*:/, "", line); 
        
        if (match(line, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) {
            ip = substr(line, RSTART, RLENGTH);

            # 1. Extract URI - Standard GET/POST check
            if (match(line, /"(GET|POST|HEAD|PUT|DELETE|OPTIONS|CONNECT) [^ ]+/)) {
                # We extract the whole match, then strip the "METHOD " part
                full_req = substr(line, RSTART + 1, RLENGTH - 1);
                split(full_req, parts, " ");
                uri = parts[2];
            } 
            else {
                # --- 2. Standard Failed: Check content between quotes ---
                if (match(line, /"[^"]*"/)) {
                    raw_content = substr(line, RSTART + 1, RLENGTH - 2);
                    
                    if (raw_content == "") {
                        uri = "EMPTY_REQUEST";
                    } 
                    else {
                        # --- 3. Not empty: Check for Binary Content ---
                        line_copy = raw_content;
                        if (gsub(/\\x[0-9a-fA-F]{2}/, "&", line_copy) >= 4) {
                            uri = "HEX_DATA:" substr(raw_content, 1, 100);
                            bot = "HEX_INJECT"; 
                        } else {
                            uri = "NON_STD:" substr(raw_content, 1, 100);
                        }
                    }
                } else {
                    uri = "MALFORMED_LINE";
                }
            }

            # 2. Extract Bot
            bot = "none";
            if (bb != "" && match(line, bb)) {
                bot = substr(line, RSTART, RLENGTH);
            }

            cnt[ip]++;

            # 3. Sticky Logic for Path
            if (uri ~ /^HEX_DATA/ || uri ~ /^NON_STD/ || (hp != "" && match(uri, hp)) || lu[ip] == "" || lu[ip] == "unknown" || lu[ip] == "OTHER") {
                lu[ip] = uri;
            }          
            
            # 4. Sticky Logic for Bot
            if (bot != "none") {
                lb[ip] = bot;
            }

            # Vhost & Subnet Logic
            split(path, p, "/"); vh="unknown"; 
            for(i=1; i<=10; i++) { if(p[i]=="system" || p[i]=="vhosts") { vh=p[i+1]; break; } }
            if(!sv[ip,vh]++) vc[ip]++;
            
            split(ip,o,"."); sn=o[1]"."o[2]"."o[3]".0/24";
            if(!ss[sn,ip]++) sic[sn]++;
        }
    } 
    END {
        for(i in cnt) {
            split(i,o,"."); sn=o[1]"."o[2]"."o[3]".0/24";
            # Print 6 columns
            print cnt[i], i, vc[i], sn "|" sic[sn], (lu[i] ? lu[i] : "unknown"), (lb[i] ? lb[i] : "none")
        }
    }' | sort -rn)

# 3. THE EXECUTIONER
while read -r HITS IP VHOSTS SUB_INFO REQ_PATH BOT; do
    [ -z "$IP" ] && continue
    IFS="|" read -r SUBNET SUB_COUNT <<< "$SUB_INFO"
    
    TARGET_TO_BAN=""
    REASON=""
    # Matching Logic is now clean and specific
    if [[ "$REQ_PATH" =~ $HONEY_PATHS ]]; then
        TARGET_TO_BAN="$IP"
        REASON="Honey Path Hit ($HITS hits)"
    elif [[ "$BOT" != "none" ]]; then
        TARGET_TO_BAN="$IP"
            REASON="Forbidden User-Agent ($BOT)"
elif [[ "$BOT" == "HEX_INJECT" || "$REQ_PATH" == HEX_DATA* ]]; then
        TARGET_TO_BAN="$IP"
        REASON="Binary/Non-Standard Request ($HITS hits)"
    elif [ "$HITS" -ge "$HIT_LIMIT" ]; then
        TARGET_TO_BAN="$IP"
        REASON="Brute Force ($HITS hits)"
    elif [ "$VHOSTS" -ge "$VHOST_LIMIT" ]; then
        TARGET_TO_BAN="$IP"
        REASON="Vhost Scan ($VHOSTS sites)"
    else
        continue
    fi
 #  echo "$HITS $IP $VHOSTS $SUB_INFO $REQ_PATH $BOT"
    # Banning / Dry-Run Output
    if [ -n "$TARGET_TO_BAN" ]; then
        if [ "$DRY_RUN" = true ]; then
            echo "[DRY-RUN] Would ban: $TARGET_TO_BAN | Reason: $REASON | $SUB_INFO | $REQ_PATH | $BOT"
            ((BANNED_THIS_RUN++))
        else
            if ! /sbin/ipset test "$IPSET_NAME" "$TARGET_TO_BAN" &>/dev/null; then
                if /sbin/ipset add "$IPSET_NAME" "$TARGET_TO_BAN" -!; then
                    ((BANNED_THIS_RUN++))
# --- Country Lookup Switch ---
    if [ "$USE_GEOIP" = "true" ] && [ -f "/usr/share/GeoIP/GeoLite2-Country.mmdb" ]; then
        CC=$(mmdblookup --file /usr/share/GeoIP/GeoLite2-Country.mmdb --ip "$TARGET_TO_BAN" country iso_code 2>/dev/null | grep -oE '"[A-Z]{2}"' | tr -d '"')
        # Fallback for successful tool run but no data found
        [[ -z "$CC" ]] && CC="??"
    else
        # Feature disabled or database missing
        CC="--"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S')|WEB|$((CURRENT_TOTAL + BANNED_THIS_RUN))|$CC $TARGET_TO_BAN|$REASON|Path: $REQ_PATH Webroots: ($VHOSTS)" >> "$MAIN_LOG"
                fi
            fi
        fi
    fi
done <<< "$RESULTS"

# 4. PERSISTENCE
STATUS="Dry-Run"

if [ "$DRY_RUN" = false ]; then
    if /sbin/ipset save "$IPSET_NAME" > "$SAVE_FILE"; then
        STATUS="Success"
    else
        STATUS="Failure"
    fi
fi
#echo "$(date '+%Y-%m-%d %H:%M:%S')|WEB|$((CURRENT_TOTAL + BANNED_THIS_RUN)) | $STATUS" >> /var/log/botlocker/error.log
