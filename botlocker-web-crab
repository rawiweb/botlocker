#!/bin/bash
# --- botlocker Production Logic ---
source /etc/botlocker/botlocker.conf
source /etc/botlocker/common.sh

# 1. INITIALIZE
HONEY_PATHS=$(load_section_patterns "web-honey" "BLACKLIST")
BAD_BOTS=$(load_section_patterns "web-bad" "BLACKLIST")
if [ -z "$HONEY_PATHS" ]; then HONEY_PATHS="REALLY_LONG_RANDOM_STRING_TO_SKIP"; fi
IGNORE_STRINGS=$(load_section_patterns "web" "WHITELIST")
if [ -z "$IGNORE_STRINGS" ]; then IGNORE_STRINGS="--NONE-FOUND--"; fi
MANUAL_IPS=$(load_section_patterns "admin-access" "MY_IPS")
AUTO_IPS=$(load_section_patterns "admin-auto" "" | sed -E 's/\|[0-9]+//g')
MY_IPS="${MANUAL_IPS}|${AUTO_IPS}"
MY_IPS=$(echo "$MY_IPS" | sed 's/||*/|/g; s/^|//; s/|$//')
ensure_firewall_integrity
AWKH_PATHS=$(echo "$HONEY_PATHS" | sed 's/\\/\\\\/g')
#AWKH_PATHS="$HONEY_PATHS"
AWKB_BOTS=$(echo "$BAD_BOTS" | sed 's/\\/\\\\/g')
#AWKB_BOTS="$BAD_BOTS"
BANNED_THIS_RUN=0

#echo "IPS: $MY_IPS"
#echo "HPs: $HONEY_PATHS"
#echo "AWH: $AWKH_PATHS"
#echo "AWB: $AWKB_BOTS"
#echo "IGN: $IGNORE_STRINGS"

read -r -a LOG_ARRAY <<< "$ACCESS_LOG_DIRS"
# 2. THE MINER
RESULTS=$(find "${LOG_ARRAY[@]}" -type f -name "*access*log" -mmin -50 -exec grep -aiEH " 404 | 403 | 400 |($HONEY_PATHS)|($BAD_BOTS)" {} + 2>/dev/null | \
    grep -vE "$MY_IPS" | \
    grep -vE "$IGNORE_STRINGS" | \
awk -F':' -v target_paths='$AWKH_PATHS' -v bot_list='$AWKB_BOTS' '
{
    log_path = $1; 
    log_line = $0; 
    
    # Strip the file path from the beginning of the line
    sub(/^[^:]*:/, "", log_line); 
    
    # Trim leading/trailing whitespace
    gsub(/^[ \t]+|[ \t]+$/, "", log_line);
    
    split(log_line, log_parts, " ");
    client_ip = log_parts[1];

    # Process only if the first part looks like a valid IPv4 address
    if (client_ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
        ip = client_ip;

        # --- 1. Domain/Virtual Host Extraction ---
        split(log_path, path_segments, "/"); 
        current_vhost = "unknown"; 
        
        # Traverse path to find the domain (usually follows "system" or "vhosts")
        for(i=1; i<=10; i++) { 
            if(path_segments[i] == "system") { 
                current_vhost = path_segments[i+1]; 
                break; 
            } 
        }
        
        # Fallback logic for global log files
        if (current_vhost == "unknown") {
            if (log_path ~ /nginx/) current_vhost = "Nginx";
            else if (log_path ~ /apache2/) current_vhost = "Apache";
            else current_vhost = "SYS-LOG";
        }
 
        # --- 2. URI / Request Path Extraction ---
        request_uri = "unknown";
        if (match(log_line, /"(GET|POST|HEAD|PUT|DELETE|OPTIONS|CONNECT) [^ ]+/)) {
            full_request = substr(log_line, RSTART + 1, RLENGTH - 1);
            split(full_request, request_parts, " ");
            request_uri = request_parts[2];
        } else if (match(log_line, /"[^"]*"/)) {
            raw_content = substr(log_line, RSTART + 1, RLENGTH - 2);
            request_uri = (raw_content == "" ? "EMPTY" : "NON_STD:" substr(raw_content, 1, 50));
        }

        # --- 3. Bot Identification ---
        detected_bot = "none";
        if (match(log_line, /"[^"]*"$/)) {
            user_agent = substr(log_line, RSTART + 1, RLENGTH - 2);
            if (bot_list != "" && match(user_agent, bot_list)) {
                detected_bot = substr(user_agent, RSTART, RLENGTH);
            }
        }

        # --- 4. Data Aggregation (Stateful Logic) ---
        hit_count[ip]++;
        
        # Track the last seen domain for this IP
        if (current_vhost != "unknown" || last_domain[ip] == "") {
            last_domain[ip] = current_vhost;
        }
        
        # Update URI if it matches target paths or if we have no record yet
        if (request_uri ~ target_paths || last_uri[ip] == "" || last_uri[ip] == "unknown") {
            last_uri[ip] = request_uri;
        }
        
        # Store bot identity if one was found
        if (detected_bot != "none") {
            last_bot[ip] = detected_bot;
        }

        # Vhost and Subnet Counters
        if (!seen_vhost_per_ip[ip, current_vhost]++) {
            unique_vhost_count[ip]++;
        }
        
        split(ip, octets, "."); 
        subnet = octets[1]"."octets[2]"."octets[3]".0/24";
        
        if (!seen_ip_in_subnet[subnet, ip]++) {
            subnet_ip_count[subnet]++;
        }
    }
} 
END {
    for (ip in hit_count) {
        split(ip, octets, "."); 
        subnet = octets[1]"."octets[2]"."octets[3]".0/24";
        
        # Output Columns: 
        # 1: HITS, 2: IP, 3: VHOST_COUNT, 4: SUBNET_INFO, 5: REQ_PATH, 6: BOT, 7: DOMAIN
        print hit_count[ip], 
              ip, 
              unique_vhost_count[ip], 
              subnet "|" subnet_ip_count[subnet], 
              (last_uri[ip] ? last_uri[ip] : "unknown"), 
              (last_bot[ip] ? last_bot[ip] : "none"), 
              last_domain[ip]
    }
}' | sort -rn)

# 3. THE EXECUTIONER
while read -r HITS IP VHOSTS SUB_INFO REQ_PATH BOT DOMAIN; do
    [ -z "$IP" ] && continue
    IFS="|" read -r SUBNET SUB_COUNT <<< "$SUB_INFO"
    
    TARGET_TO_BAN=""
    REASON=""
    
    # Matching Logic is now clean and specific
    if [[ "$REQ_PATH" =~ $HONEY_PATHS ]]; then
        TARGET_TO_BAN="$IP"
        REASON="Honey Path Hit"
    elif [[ "$BOT" != "none" ]]; then
        TARGET_TO_BAN="$IP"
        REASON="Forbidden User-Agent"
        DETAIL="($BOT) ($HITS hits)"
    elif [[ "$BOT" == "HEX_INJECT" || "$REQ_PATH" == NON_STD* ]]; then
        TARGET_TO_BAN="$IP"
        REASON="Binary/Non-Standard Request"
        DETAIL="($HITS hits)"
    elif [ "$HITS" -ge "$HIT_LIMIT" ]; then
        TARGET_TO_BAN="$IP"
        REASON="Brute Force ($HITS hits)"
    elif [ "$VHOSTS" -ge "$VHOST_LIMIT" ]; then
        TARGET_TO_BAN="$IP"
        REASON="Vhost Scan"
        DETAIL="($VHOSTS sites) ($HITS hits)"
    else
        continue
    fi
    DETAIL+=" on $REQ_PATH"
 #  echo "$HITS $IP $VHOSTS $SUB_INFO $REQ_PATH $BOT"
    # Banning / Dry-Run Output
    if [ -n "$TARGET_TO_BAN" ]; then
            if [[ ! "$TARGET_TO_BAN" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(\/[0-9]+)?$ ]]; then
                continue
            fi
           if [ "$DRY_RUN" = false ]; then
             ban_ip "$IP" && log_ban_event "WEB" "$IP" "$REASON" "$DOMAIN $DETAIL"
           else
           ((BANNED_THIS_RUN++)) 
            echo "[DRY-RUN] $BANNED_THIS_RUN Would ban: $IP | $REASON | $DOMAIN $DETAIL"
          fi
         DETAIL=""
    fi
done <<< "$RESULTS"
#echo "$RESULTS"