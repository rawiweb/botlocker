#!/bin/bash

source /etc/botlocker/botlocker.conf
source /etc/botlocker/common.sh
WHITELIST_FILE="/etc/botlocker/conf.d/admin-autowhitelist.conf"
# Handle potential typo and set defaults
[ -z "$UNBAN_REQUEST_FILE" ] && UNBAN_REQUEST_FILE="$UBAN_REQUEST_FILE"
EXPIRY_TIME=${WHITELIST_EXPIRY:-86400} 

# Get a fresh starting total
CURRENT_TOTAL=$(/sbin/ipset list "$IPSET_NAME" 2>/dev/null | grep "Number of entries" | awk '{print $4}')
UNBANNED=0
BANNED=0
CC="--" 
# 2. Process Requests
if [ -f "$UNBAN_REQUEST_FILE" ] && [ -s "$UNBAN_REQUEST_FILE" ]; then
    while read -r LINE || [ -n "$LINE" ]; do
        ACTION=$(echo "$LINE" | awk '{print $1}')
        CLEAN_IP=$(echo "$LINE" | awk '{print $2}' | tr -d '\r' | xargs)

        [ -z "$CLEAN_IP" ] && continue
       CC=$(country_lookup $CLEAN_IP)

        case "$ACTION" in
            "ubn")
               
                NOW=$(date +%s)
                mkdir -p "$(dirname "$WHITELIST_FILE")"
                WHITE_IP="${CLEAN_IP%%/*}"
                if [[ "$WHITE_IP" == *.0 ]]; then
                      WHITE_IP="${WHITE_IP%.0}."
                fi

                if [[ -n "$WHITE_IP" ]]; then
                   echo "$WHITE_IP|$NOW" >> "$WHITELIST_FILE"
                fi  
                sort -o "$WHITELIST_FILE" -u "$WHITELIST_FILE"
                
                /sbin/ipset del "$IPSET_NAME" "$CLEAN_IP" 2>/dev/null
                ((UNBANNED++))
                ((CURRENT_TOTAL--))
                echo "$(date '+%Y-%m-%d %H:%M:%S')|UNBAN|$CURRENT_TOTAL|$CC $CLEAN_IP|Manual|Admin Whitelist" >> "$MAIN_LOG"
                ;;

            "prm")
#                /sbin/ipset add "$IPSET_NAME" "$CLEAN_IP" timeout 0 -exist 2>/dev/null
  #              ((BANNED++))
                ban_ip "$CLEAN_IP" && log_ban_event "PERM" "$CLEAN_IP" "Manual" "Promoted to Permanent"
                ;;
        esac
    done < "$UNBAN_REQUEST_FILE"
    
    > "$UNBAN_REQUEST_FILE"
    chmod 666 "$UNBAN_REQUEST_FILE"
fi

# 3. Whitelist Expiry Logic
if [ -f "$WHITELIST_FILE" ]; then
    NOW=$(date +%s)
    TEMP_WL=$(mktemp)
    while IFS='|' read -r w_ip w_time; do
        # If timestamp is missing, give it a fresh one
        [[ -z "$w_time" ]] && w_time=$NOW
        if [ $((NOW - w_time)) -lt "$EXPIRY_TIME" ]; then
            echo "$w_ip|$w_time" >> "$TEMP_WL"
        fi
    done < "$WHITELIST_FILE"
    
    mv "$TEMP_WL" "$WHITELIST_FILE"
    chmod 666 "$WHITELIST_FILE"
fi


# --- DEDUPLICATION ---
SUBNETS=$(/sbin/ipset list "$IPSET_NAME" | grep '/24' | awk '{print $1}')
for NET in $SUBNETS; do
    PREFIX=$(echo $NET | cut -d. -f1-3)
    /sbin/ipset list "$IPSET_NAME" | grep "^$PREFIX" | grep -v "/24" | while read -r DUPE; do
        IP_ONLY=$(echo $DUPE | awk '{print $1}')
        /sbin/ipset del "$IPSET_NAME" "$IP_ONLY" 2>/dev/null
        ((CURRENT_TOTAL--))
        # Fixed variable from $p_ip to $IP_ONLY and closed the quote
       CC=$(country_lookup $IP_ONLY)
        echo "$(date '+%Y-%m-%d %H:%M:%S')|UNBAN|$CURRENT_TOTAL|$CC $IP_ONLY|Auto|Consolidated into $NET" >> "$MAIN_LOG"
    done
done

# 5. Enforce Permanent Bans
PERM_FILE="/etc/botlocker/conf.d/permanent-bans.conf"
if [ -f "$PERM_FILE" ] && [ -s "$PERM_FILE" ]; then
    grep -vE '^#|^\[|^$' "$PERM_FILE" | while read -r p_ip; do
        ban_ip "$p_ip" && log_ban_event "PERM" "$p_ip" "Admin ban" "via Web UI Manual File Entry" 
    done
    > "$PERM_FILE"
fi

# 6. Final Web Report Update
/sbin/ipset list "$IPSET_NAME" 2>/dev/null | grep -E '^[0-9]' > "$IP_REPORT_WEB"
chmod 644 "$IP_REPORT_WEB"

#7 Ipset Hall of shame
current_min=$(date +%-M)
if [ "$current_min" -eq 0 ]; then
SHAME_DATA=$(ipset list "$IPSET_NAME" | awk '
/packets/ && /bytes/ {
    p=0; b=0; 
    for(i=1; i<=NF; i++) {
        if($i == "packets") p = $(i+1);
        if($i == "bytes") b = $(i+1);
    }
    # 1. Store data in an array indexed by the IP
    # We store the "sortable" value (bytes) and the raw string
    ips[$1] = b;
    lines[$1] = sprintf("%-15s %10.2f KB %10d pkts", $1, b/1024, p);
    packets[$1] = p;

    # 2. Add to Grand Totals
    total_p += p;
    total_b += b;
    count++;
}
END {
    # 3. Sort the array by bytes (descending) - using gawk specific sorting
    # If not using gawk, we can pipe the END block output to sort
    PROCINFO["sorted_in"] = "@val_num_desc";
    
    i = 0;
    for (ip in ips) {
        if (i < 10) {
            avg = (packets[ip] > 0) ? ips[ip] / packets[ip] : 0;
            printf "%s \tAvg: %.2f bytes/pkt\n", lines[ip], avg;
        }
        i++;
    }
    
    # 4. Print Summary
    print "---------------------------------------------------------------------------";
    total_avg = (total_p > 0) ? total_b / total_p : 0;
    printf "TOTAL (%d IPs) %7.2f KB %10d pkts \tAvg: %.2f bytes/pkt\n", count, total_b/1024, total_p, total_avg;
}')
echo "$SHAME_DATA" > "$SHAME_PATH"
chmod 644 "$SHAME_PATH"


{
    echo ""
    echo "---Net Report Generated: $(date '+%Y-%m-%d %H:%M:%S') ---"
    echo "Count | Subnet Range    | Organization/Owner"
    echo "------------------------------------------------"

    while read -r count ip_prefix; do
        # We add .1 to the prefix to make it a valid IP for the whois query
        # timeout 2 prevents a single slow server from stalling your whole script
        org=$(timeout 2 whois "$ip_prefix.1" | grep -Ei "descr|org-name|organization|netname|role|owner" | head -n 1 | cut -d: -f2 | xargs)
        
        # If WHOIS is empty or timed out, label it clearly
        if [[ -z "$org" ]]; then org="No Organization Data Found"; fi

        printf "%-5s | %-15s | %s\n" "$count" "$ip_prefix.0/24" "$org"
        
    done < <(awk '{print $1}' "$IP_REPORT_WEB" | cut -d. -f1-3 | sort | uniq -c | sort -nr | head -n 10)

} >> "$SHAME_PATH"
fi

# 8. Audit grace period reban/release cycle
WINDOW=86400
UBN_DATA=$(/sbin/ipset list "$IPSET_NAME" | awk -v win="$WINDOW" '/timeout/ && $3 > 0 && $3 < win {print $1"|"$3"|"$5"|"$9"|"}')
if [ -n "$UBN_DATA" ]; then
    for ENTRY in $UBN_DATA; do

        IFS="|" read -r IP CUR_TIMEOUT LIVE_PKTS RAW_COMMENT <<< "$ENTRY"
        COMMENT=$(echo "$RAW_COMMENT" | tr -d '"')

        if [ -z "$COMMENT" ]; then
           # PHASE 1: START AUDIT (Pin the timer!)
           /sbin/ipset add "$IPSET_NAME" "$IP" -exist timeout "$CUR_TIMEOUT" comment "audit_pkts:$LIVE_PKTS"
            log_ban_event "AUDIT" "$IP" "Monitoring Started" "Pkts: $LIVE_PKTS | Ends in: ${CUR_TIMEOUT}s"

        elif [[ "$COMMENT" == audit_pkts:* ]]; then
            # PHASE 2: EVALUATE
            START_PKTS=${COMMENT#audit_pkts:}
            CC=$(country_lookup "$IP")
            if [[ "$START_PKTS" =~ ^[0-9]+$ ]] && [ "$LIVE_PKTS" -gt "$START_PKTS" ]; then
                # VERDICT: RE-BAN
                /sbin/ipset add "$IPSET_NAME" "$IP" -exist comment "" 
                log_ban_event "REBAN" "$IP" "Failed Parole" "New Activity: $((LIVE_PKTS - START_PKTS)) pkts"
            elif [ "$CUR_TIMEOUT" -lt 300 ]; then
                # VERDICT: RELEASE
                log_ban_event "RELEASE" "$IP" "Passed Parole" "No activity during audit"
            fi
        fi
    done
fi

# 9. Save/Sync Status
if [ "$DRY_RUN" = false ]; then
    /sbin/ipset save "$IPSET_NAME" > "$SAVE_FILE"
fi
