#!/bin/bash

# Load Config
CONF_FILE="/etc/botlocker/botlocker.conf"
if [ ! -f "$CONF_FILE" ]; then
    echo "Error: Config file not found at $CONF_FILE"
    exit 1
fi
source "$CONF_FILE"

[ -z "$UNBAN_REQUEST_FILE" ] && UNBAN_REQUEST_FILE="$UBAN_REQUEST_FILE"
if [ "$DRY_RUN" = false ]; then
    if ! /sbin/iptables-save | grep -q "match-set $IPSET_NAME src"; then
        /sbin/iptables -I INPUT 1 -m set --match-set "$IPSET_NAME" src -j DROP
    fi
fi

CURRENT_TOTAL=$(/sbin/ipset list "$IPSET_NAME" | grep "Number of entries" | awk '{print $4}')
UNBANNED=0

# 2. Process Requests (ubn = Unban, prm = Permanent)
if [ -s "$UNBAN_REQUEST_FILE" ]; then
    while read -r LINE || [ -n "$LINE" ]; do
        # Format expected: "ubn 1.2.3.4" or "prm 1.2.3.4"
        ACTION=$(echo "$LINE" | awk '{print $1}')
        CLEAN_IP=$(echo "$LINE" | awk '{print $2}' | tr -d '\r' | xargs)

        [ -z "$CLEAN_IP" ] && continue

        case "$ACTION" in
            "ubn")
                # --- Standard Admin Unban ---
                WHITELIST_FILE="/etc/botlocker/conf.d/admin-autowhitelist.conf"
                NOW=$(date +%s)
                echo "$CLEAN_IP|$NOW" >> "$WHITELIST_FILE"
                sort -o "$WHITELIST_FILE" -u "$WHITELIST_FILE"
                
                /sbin/ipset del "$IPSET_NAME" "$CLEAN_IP" 2>/dev/null
                
                ((UNBANNED++))
                echo "$(date '+%Y-%m-%d %H:%M:%S')|UNBAN|$((CURRENT_TOTAL - UNBANNED))|$CLEAN_IP|Manual|Admin Whitelist" >> "$MAIN_LOG"
                ;;

            "prm")
                # --- Upgrade to Permanent ---
                PERM_FILE="/etc/botlocker/conf.d/permanent-bans.conf"
                echo "$CLEAN_IP" >> "$PERM_FILE"
                sort -o "$PERM_FILE" -u "$PERM_FILE"
                
                # Reset kernel timer to 0 (Forever)
                /sbin/ipset add "$IPSET_NAME" "$CLEAN_IP" timeout 0 -exist
                
                echo "$(date '+%Y-%m-%d %H:%M:%S')|PERM|$CURRENT_TOTAL|$CLEAN_IP|Manual|Promoted to Permanent" >> "$MAIN_LOG"
                ;;
                
            *)
                # Fallback for old style (just IP) - Treat as Unban
                /sbin/ipset del "$IPSET_NAME" "$CLEAN_IP" 2>/dev/null
                ;;
        esac
    done < "$UNBAN_REQUEST_FILE"
    
    > "$UNBAN_REQUEST_FILE"
fi
    chmod 666 "$UNBAN_REQUEST_FILE"
fi

WHITELIST_FILE="/etc/botlocker/conf.d/admin-autowhitelist.conf"
if [ -f "$WHITELIST_FILE" ]; then
    EXPIRY_TIME=216000
    NOW=$(date +%s)
    TEMP_WL=$(mktemp)
    
    while IFS='|' read -r w_ip w_time; do
        # If timestamp is missing (old style), give it a fresh timestamp
        [[ -z "$w_time" ]] && w_time=$NOW
        if [ $((NOW - w_time)) -lt $EXPIRY_TIME ]; then
            echo "$w_ip|$w_time" >> "$TEMP_WL"
        fi
    done < "$WHITELIST_FILE"
    
    mv "$TEMP_WL" "$WHITELIST_FILE"
    chmod 666 "$WHITELIST_FILE"
fi

STATUS="DRY_RUN"
if [ "$DRY_RUN" = false ]; then
    if /sbin/ipset save "$IPSET_NAME" > "$SAVE_FILE"; then
        STATUS="Success"
    else
        STATUS="Failure"
    fi
fi

# Extract IPs from the permanent list
PERM_FILE="/etc/botlocker/conf.d/permanent-bans.conf"
if [ -f "$PERM_FILE" ]; then
    grep -vE '^#|^\[|^$' "$PERM_FILE" | while read -r p_ip; do
        /sbin/ipset add "$IPSET_NAME" "$p_ip" timeout 0 -exist 2>/dev/null
    done
fi

# 3. Final Web Report Update
/sbin/ipset list "$IPSET_NAME" | grep -E '^[0-9]' > "$IP_REPORT_WEB"
chmod 644 "$IP_REPORT_WEB"
#echo "$(date '+%Y-%m-%d %H:%M:%S')|UBN|$((CURRENT_TOTAL + BANNED_THIS_RUN)) | $STATUS" >> /var/log/botlocker/error.log
