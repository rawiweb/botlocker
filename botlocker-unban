#!/bin/bash
source /etc/botlocker/botlocker.conf
source /etc/botlocker/common.sh
WHITELIST_FILE="/etc/botlocker/conf.d/admin-autowhitelist.conf"
# Handle potential typo and set defaults
[ -z "$UNBAN_REQUEST_FILE" ] && UNBAN_REQUEST_FILE="$UBAN_REQUEST_FILE"
EXPIRY_TIME=${WHITELIST_EXPIRY:-86400} 

# Get a fresh starting total
CURRENT_TOTAL=$(/sbin/ipset list "$IPSET_NAME" 2>/dev/null | grep "Number of entries" | awk '{print $4}')
UNBANNED=0
BANNED=0
CC="--" 
# 2. Process Requests
if [ -f "$UNBAN_REQUEST_FILE" ] && [ -s "$UNBAN_REQUEST_FILE" ]; then
while read -r LINE || [ -n "$LINE" ]; do
      # 1. Use 'cut' instead of 'awk | xargs' to keep the backslashes safe
    ACTION=$(echo "$LINE" | cut -d' ' -f1)
    CLEAN_IP=$(echo "$LINE" | cut -d' ' -f2- | tr -d '\r')
    
    [ -z "$CLEAN_IP" ] && continue
    
    CC=$(country_lookup "$CLEAN_IP")
#  echo "$(date): READ UNBANN: ACTION $ACTION IP $CLEAN_IP"  
    case "$ACTION" in
# ... inside the while loop ...
        "ubn")
            NOW=$(date +%s)
            mkdir -p "$(dirname "$WHITELIST_FILE")"
            
            # 1. Escape dots if they aren't already escaped
            if [[ "$CLEAN_IP" != *\\.* ]]; then
                SAFE_IP=$(echo "$CLEAN_IP" | sed 's/\./\\./g')
            else
                SAFE_IP="$CLEAN_IP"
            fi

            # 2. Handle CIDR vs Single IP
if [[ "$CLEAN_IP" == */* ]]; then
    # Start with NAKED IP (no escapes) to avoid double-slashing
    NAKED_IP=$(echo "$CLEAN_IP" | tr -d '^$\\')
    BASE_IP="${NAKED_IP%/*}"
    PREFIX="${BASE_IP%.0}"
    WHITE_IP="^$(echo "$PREFIX" | sed 's/\./\\./g')\."
else
    NAKED_IP=$(echo "$CLEAN_IP" | tr -d '^$\\')
    WHITE_IP="^$(echo "$NAKED_IP" | sed 's/\./\\./g')$"
fi

            # 3. Write to file ONLY if WHITE_IP is not just an anchor
            if [[ "$WHITE_IP" != "^" && "$WHITE_IP" != "^$" ]]; then
                echo "$WHITE_IP|$NOW" >> "$WHITELIST_FILE"
            fi  
            
            # 4. Cleanup for IPSET (must be a naked IP/CIDR)
            # This handles both 1.2.3.4 and 1.2.3.0/24  
            IPSET_IP=$(echo "$CLEAN_IP" | tr -d '^$\\')
            /sbin/ipset del "$IPSET_NAME" "$IPSET_IP" 2>/dev/null
            
            ((UNBANNED++))
            ((CURRENT_TOTAL--))
#            echo "CASE ACTION WAS EXECUTED"
            echo "$(date '+%Y-%m-%d %H:%M:%S')|UNBAN|$CURRENT_TOTAL|$CC $IPSET_IP|Manual|Admin Whitelist" >> "$MAIN_LOG"
            ;;

        "prm"|"abn")
           
            # Ensure we don't strip the forward slash for CIDR blocks!
            BAN_TARGET=$(echo "$CLEAN_IP" | tr -d '^$\\')
            REASON="Promoted to Net $BAN_TARGET/24"
            [[ "$ACTION" == "abn" ]] && REASON="Promoted to Net $BAN_TARGET/24 by hitting limit"
            echo "ENTERING ABN/PRM TARGETIP $BAN_TARGET REASON $REASON"
            # Crucial: Check if ban_ip actually succeeded
            ban_ip "$BAN_TARGET" && log_ban_event "NET" "$BAN_TARGET" "${ACTION^^}" "$REASON"
                ((BANNED++))
            ;;

    esac
done < "$UNBAN_REQUEST_FILE"
    
    > "$UNBAN_REQUEST_FILE"
    chmod 666 "$UNBAN_REQUEST_FILE"
fi

if [ -f "$WHITELIST_FILE" ]; then
    NOW=$(date +%s)
    CLEAN_LIST=$(while IFS='|' read -r ip ts || [ -n "$ip" ]; do
        # Skip empty lines or header lines if they accidentally got in RAW_DATA
        [[ "$ip" =~ ^\[ || -z "$ip" ]] && continue
        [[ -z "$ts" ]] && ts=$NOW
        if (( (NOW - ts) < EXPIRY_TIME )); then
            echo "$ip|$ts"
        fi
    done <<< "$(grep '|' "$WHITELIST_FILE")")
    {
        echo "[WHITELIST]"
        if [[ -n "$CLEAN_LIST" ]]; then
            echo "$CLEAN_LIST"
        fi
        echo "[END]"
    } > "$WHITELIST_FILE"
    chmod 666 "$WHITELIST_FILE"
fi

# --- DEDUPLICATION ---
SUBNETS=$(/sbin/ipset list "$IPSET_NAME" | grep '/24' | awk '{print $1}')
for NET in $SUBNETS; do
    NET_TMOUT=$(/sbin/ipset list "$IPSET_NAME" | grep "^$NET " | grep -Po 'timeout \K[0-9]+')
    PREFIX=$(echo "$NET" | cut -d. -f1-3)
    NET_UNBANNED=0
    SUM_PACKETS=0
    SUM_BYTES=0

    while read -r LINE; do
        IP_ONLY=$(echo "$LINE" | awk '{print $1}')
        PKTS=$(echo "$LINE" | grep -Po 'packets \K[0-9]+')
        BYTS=$(echo "$LINE" | grep -Po 'bytes \K[0-9]+')
        ((SUM_PACKETS += PKTS))
        ((SUM_BYTES += BYTS))
        /sbin/ipset del "$IPSET_NAME" "$IP_ONLY" 2>/dev/null
        ((CURRENT_TOTAL--))
        ((NET_UNBANNED++))
    done < <(/sbin/ipset list "$IPSET_NAME" | grep "^$PREFIX\." | grep -v "/24")
        if [ "$NET_UNBANNED" -gt 0 ]; then
            /sbin/ipset add "$IPSET_NAME" "$NET" timeout "$NET_TMOUT" packets "$SUM_PACKETS" bytes "$SUM_BYTES" -exist
            org=$(org_lookup "$IP_ONLY")
            log_ban_event "GROUP" "$IP_ONLY" "Consolidated $NET_UNBANNED IPs into $NET" "$org ($SUM_PACKETS pkts / $SUM_BYTES b)"
        fi
done

# 5. Enforce Permanent Bans
PERM_FILE="/etc/botlocker/conf.d/permanent-bans.conf"
if [ -f "$PERM_FILE" ] && [ -s "$PERM_FILE" ]; then
    grep -vE '^#|^\[|^$' "$PERM_FILE" | while read -r p_ip; do
        ban_ip "$p_ip" && log_ban_event "PERM" "$p_ip" "Admin ban" "via Web UI Manual File Entry" 
    done
    > "$PERM_FILE"
fi

# 6. Final Web Report Update
/sbin/ipset list "$IPSET_NAME" 2>/dev/null | grep -E '^[0-9]' > "$IP_REPORT_WEB"
chmod 644 "$IP_REPORT_WEB"

#7 Ipset Hall of shame
current_min=$(date +%-M)
if [ "$current_min" -eq 0 ]; then
SHAME_DATA=$(ipset list "$IPSET_NAME" | awk '
/packets/ && /bytes/ {
    p=0; b=0; 
    for(i=1; i<=NF; i++) {
        if($i == "packets") p = $(i+1);
        if($i == "bytes") b = $(i+1);
    }
    # 1. Store data in an array indexed by the IP
    # We store the "sortable" value (bytes) and the raw string
    ips[$1] = b;
    lines[$1] = sprintf("%-15s %10.2f KB %10d pkts", $1, b/1024, p);
    packets[$1] = p;

    # 2. Add to Grand Totals
    total_p += p;
    total_b += b;
    count++;
}
END {
    # 3. Sort the array by bytes (descending) - using gawk specific sorting
    # If not using gawk, we can pipe the END block output to sort
    PROCINFO["sorted_in"] = "@val_num_desc";
    print "--------------------- Top10 Ip by hits ------------------------------"
    print "IP-address          Data          Packages      Average"
    print "---------------------------------------------------------------------"
    
    i = 0;
    for (ip in ips) {
        if (i < 10) {
            avg = (packets[ip] > 0) ? ips[ip] / packets[ip] : 0;
            printf "%s \tAvg: %.2f bytes/pkt\n", lines[ip], avg;
        }
        i++;
    }
    
    # 4. Print Summary
# 4. Print Summary
print "---------------------------------------------------------------------";

# Byte scaling
size_kb = total_b / 1024;
unit = "KB";
if (size_kb >= 1024) {
    size_kb /= 1024;
    unit = "MB";
}

# Packet scaling (using 1000 for "K" and "M" units)
size_pkg = total_p / 1000;
punit = "K";
if (size_pkg >= 1000) {
    size_pkg /= 1000;
    punit = "M";
}

total_avg = (total_p > 0) ? total_b / total_p : 0;

# The fix: added the %s for punit and aligned the columns
printf "TOTAL (%d IPs) | %7.2f %-2s | %7.2f %-1s pkts | Avg: %.2f bytes/pkt\n", \
    count, size_kb, unit, size_pkg, punit, total_avg;
}')
echo "$SHAME_DATA" > "$SHAME_PATH"
chmod 644 "$SHAME_PATH"


{
    read -r raw_pkts raw_bytes <<< $(iptables -L INPUT -n -v -x | grep "match-set botlocker_trap" | awk '{print $1, $2}')
    formatted_pkts=$(printf "%'d" $raw_pkts)
    formatted_bytes=$(numfmt --to=iec-i --suffix=B $raw_bytes)
    total_ips=$(ipset list botlocker_trap | grep "Number of entries" | awk '{print $4}')
    echo ""
    echo "--- Net Report Generated: $(date '+%Y-%m-%d %H:%M:%S') ---"
    echo "Firewall Shield: $formatted_pkts packets blocked ($formatted_bytes)"
    echo "Jail Population: $total_ips unique IPs in botlocker_trap"
    echo ""
    echo "Count | CC | Subnet Range    | Organization/Owner"
    echo "--------------------------------------------------------"
    while read -r count ip_prefix; do
        CLEAN_IP="${ip_prefix}.1"
        cc=$(country_lookup "$CLEAN_IP")
        org=$(org_lookup "$CLEAN_IP")
        if [ "$count" -ge "$SUB_COUNT_LIMIT" ]; then
           echo "abn $ip_prefix.0/24" >> "$UNBAN_REQUEST_FILE"
           echo "FOUND $SUB_COUNT_LIMIT ips in ipset"
        fi
        printf "%-5s | %-2s | %-15s | %s\n" "$count" "$cc" "$ip_prefix.0/24" "$org"
    done < <(awk '{print $1}' "$IP_REPORT_WEB" | cut -d. -f1-3 | sort | uniq -c | sort -nr | head -n 20)
} >> "$SHAME_PATH"
fi

# 8. Audit grace period reban/release cycle
WINDOW=86400
UBN_DATA=$(/sbin/ipset list "$IPSET_NAME" | awk -v win="$WINDOW" '/timeout/ && $3 > 0 && $3 < win {print $1"|"$3"|"$5"|"$9"|"}')
if [ -n "$UBN_DATA" ]; then
    NO_RELEASED=0
    NO_REBANNED=0
    RIPS=""
    RBIPS=""
    for ENTRY in $UBN_DATA; do
        IFS="|" read -r IP CUR_TIMEOUT LIVE_PKTS RAW_COMMENT <<< "$ENTRY"
        COMMENT=$(echo "$RAW_COMMENT" | tr -d '"')

        if [ -z "$COMMENT" ]; then
           # PHASE 1: START AUDIT
           /sbin/ipset add "$IPSET_NAME" "$IP" -exist timeout "$CUR_TIMEOUT" comment "audit_pkts:$LIVE_PKTS"
           # log_ban_event "AUDIT" "$IP" "Monitoring Started" "Pkts: $LIVE_PKTS"
        elif [[ "$COMMENT" == audit_pkts:* ]]; then
            # PHASE 2: EVALUATE
            START_PKTS=${COMMENT#audit_pkts:}
            if [[ "$START_PKTS" =~ ^[0-9]+$ ]] && [ "$LIVE_PKTS" -gt "$START_PKTS" ]; then
                # VERDICT: RE-BAN
                /sbin/ipset add "$IPSET_NAME" "$IP" -exist comment "" 
               ((NO_REBANNED++))
                RBIPS+="$IP / "
            elif [ "$CUR_TIMEOUT" -lt 300 ]; then
                ((NO_RELEASED++))
                RIPS+="$IP / "
            fi
        fi
    done

    IP=$(hostname -I | awk '{print $1}')
    if [ "$NO_REBANNED" -gt 0 ]; then 
     CLEAN_RBIPS=$(echo "$RBIPS" | sed 's/ \/ $//')
     log_ban_event "REBAN" "$IP" "Failed Parole" "Activity during audit ($NO_REBANNED IPs) $CLEAN_RBIPS"
    fi
    if [ "$NO_RELEASED" -gt 0 ]; then 
     CLEAN_RIPS=$(echo "$RIPS" | sed 's/ \/ $//')
     log_ban_event "RELEASE" "$IP" "Passed Parole" "No activity during audit ($NO_RELEASED IPs) $CLEAN_RIPS"
    fi
fi

# 9. Save/Sync Status
if [ "$DRY_RUN" = false ]; then
    /sbin/ipset save "$IPSET_NAME" > "$SAVE_FILE"
fi
