#!/bin/bash
sleep 0.8
source /etc/botlocker/botlocker.conf
source /etc/botlocker/common.sh

MAIL_SEARCH=$(load_section_patterns "mail" "BLACKLISTUSERS")
HOST_SEARCH=$(load_section_patterns "mail" "BLACKLISTNETS")
[[ -z "$MAIL_SEARCH" ]] && MAIL_SEARCH="NO_USERS_DEFINED"
[[ -z "$HOST_SEARCH" ]] && HOST_SEARCH="NO_HOSTS_DEFINED"

AWKH_SEARCH=$(echo "$HOST_SEARCH" | sed 's/\\/\\\\/g')
AWKM_SEARCH=$(echo "$MAIL_SEARCH" | sed 's/\\/\\\\/g')
#AWKH_SEARCH="$HOST_SEARCH"
# 1. SELF-HEALING FIREWALL
ensure_firewall_integrity
BANNED_THIS_RUN=0
#echo "Hostsearch:$HOST_SEARCH AwkPattern: $AWKH_SEARCH"
if [ ! -f "$MAIL_LOG" ]; then
    exit 1
fi

# 2. Capture Failures (STRICT: Stripped of noise and successes)
# We remove "lost connection" and "success" right at the source.
FAILURES=$(grep -aiEi "auth failed|authentication failure|password mismatch|login failed|auth=0/|$HOST_SEARCH" "$MAIL_LOG" | \
           grep -vEi "Login:|logged in|authenticated|success|lost connection after AUTH")
#[ -z "$FAILURES" ] && exit 0
#echo "$HOST_SEARCH in $FAILURES"
# 3. UNIFIED PROCESSING LOOP
while read -r COUNT IP REASON IDENTITY SERVICE; do
    [ -z "$IP" ] && continue
    
    # TRIGGER LOGIC: Instant ban on *-MATCH, or threshold hit on BRUTE
    if [[ "$REASON" == *"-MATCH"* ]] || [ "$COUNT" -ge "$THRESHOLD" ]; then
        
        # Format labels for the log_ban_event
        LABEL="${SERVICE}-Bruteforce"
        [[ "$REASON" == "NAME-MATCH" ]] && LABEL="${SERVICE}-Hostname"
        [[ "$REASON" == "USER-MATCH" ]] && LABEL="${SERVICE}-Blacklist"
        
        [[ "$REASON" == "NAME-MATCH" ]] && DETAIL="Host: $IDENTITY"
        [[ "$REASON" == "USER-MATCH" ]] && DETAIL="User: $IDENTITY"
        if [ "$DRY_RUN" = false ]; then
            # We use the $REASON ($COUNT hits) to show exactly why it happened in reports
            ban_ip "$IP" && log_ban_event "MAIL" "$IP" "$LABEL ($COUNT hits)" "$DETAIL"
        else
            echo "[DRY-RUN] Would ban: $IP | $REASON | $DETAIL"
            ((BANNED_THIS_RUN++))
        fi
    fi
done < <(
    {
        # 2. PASS THE NEW VARIABLE INTO AWK (-v h_bl="$AWKH_SEARCH")
        echo "$FAILURES" | awk -v u_bl="$AWKM_SEARCH" -v h_bl="$AWKH_SEARCH" '
        BEGIN { 
            split(tolower(u_bl), u_array, "|"); 
            split(tolower(h_bl), h_array, "|"); 
        }
        {

            service = "MAIL"; 
            if ($0 ~ /smtpd/) { service = "SMTP"; }
            else if ($0 ~ /courier-imap/) { service = "IMAP"; }

            # Extract IP
            ip = "0.0.0.0";
            if (match($0, /\[(::ffff:)?([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\]/, arr)) { ip = arr[2]; }
            
            # Extract Hostname
            host = "none";

            host = "none";
            if (match($0, /(from |warning: )([^\[ \t:]+)\[/, h_arr)){
                host = tolower(h_arr[2]); 
                gsub(/[ \t]+$/, "", host); 
            }

            user = "unknown";
            if (match($0, /sasl_username=([^ ,>]+)/, u_arr)) {
                user = tolower(u_arr[1]);
            } else if (match($0, /(user=|user=<)([^ ,>]+)/, u_arr)) {
                user = tolower(u_arr[2]);
                gsub(/[<>,= ]/, "", user);
            }

            # Logic Check
            is_h_bl = 0;
            for (i in h_array) {
                if (h_array[i] != "" && host ~ h_array[i]) { is_h_bl = 1; break; }
            }

            is_u_bl = 0;
            for (i in u_array) {
                if (u_array[i] != "" && (user == u_array[i] || user ~ "^" u_array[i])) { is_u_bl = 1; break; }
            }

            if (ip != "0.0.0.0") {
                if (is_h_bl)      print ip, "NAME-MATCH", host, service;
                else if (is_u_bl) print ip, "USER-MATCH", user, service;
                else              print ip, "SMTP-BRUTE", user, service;
            }
        }' | sort | uniq -c | awk '{print $1, $2, $3, $4, $5}'
    } | grep -vEi "$IP_SEARCH"
)
# 4. PERSISTENCE
STATUS="Dry-Run"
if [ "$DRY_RUN" = false ]; then
    if /sbin/ipset save "$IPSET_NAME" > "$SAVE_FILE"; then
        STATUS="Success"
    else
        STATUS="Failure"
    fi
fi
#   echo "$(date '+%Y-%m-%d %H:%M:%S')|MAIL|$((CURRENT_TOTAL + BANNED_THIS_RUN)) | $STATUS" >> /var/log/botlocker/error.log